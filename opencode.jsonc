{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },

  "permission": {
    "bash": "ask",
    "edit": "ask",
    "myserver_*": "ask"
  },

  "mcp": {
    "myserver": {
      "type": "remote",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:MCP_API_KEY}"
      }
    }
  }
}